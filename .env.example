# ── ARGOS Environment Configuration ──────────────────────────────────────────
# Copy to .env and fill in your values.
# Never commit .env to git.

# ── Claude (required) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-6

# ── Bitbucket (required for Bitbucket scanning) ───────────────────────────────
BITBUCKET_MODE=cloud                              # cloud | datacenter
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0 # DC: https://bitbucket.yourcompany.com
BITBUCKET_TOKEN=your-bitbucket-pat
BITBUCKET_WORKSPACE=your-workspace               # Cloud only
BITBUCKET_WEBHOOK_SECRET=your-webhook-secret

# ── GitHub (optional) ────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Infrastructure (use docker-compose defaults for local dev) ────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://argos:argos@localhost:5432/argos
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argos
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                                  # empty for local

# ── Threat Intelligence ───────────────────────────────────────────────────────
NVD_API_KEY=                                      # optional, increases NVD rate limit
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ── Alerts ───────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
PAGERDUTY_ROUTING_KEY=your-pd-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=security@yourorg.com

# ── Scanning Behaviour ────────────────────────────────────────────────────────
MAX_PARALLEL_WORKERS=8
MIN_RANKER_SCORE=3
DELTA_SCAN_ENABLED=true
CVE_POLL_INTERVAL_HOURS=1

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
